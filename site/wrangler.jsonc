{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "tsumugi-docs",
  "compatibility_date": "2026-07-01",
  "assets": {
    "html_handling": "auto-trailing-slash",
  },
  "d1_databases": [{ "binding": "DB", "database_name": "tsumugi-docs" }],
  "routes": [{ "pattern": "tsumugi.mq1.dev", "custom_domain": true }],
  "workers_dev": false,
}
