{
  "name": "@tsumugi/spec",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "TypeSpec definition of the Tsumugi REST API",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
