    }
  },
  "scripts": {
    "build": "tsp compile . && node scripts/emit-module.mjs",
    "prepare": "pnpm build"
  },
  "devDependencies": {
    "@typespec/compiler": "^1.9.0",
    "@typespec/http": "^1.9.0",
    "@typespec/openapi": "^1.9.0",
    "@typespec/openapi3": "^1.9.0"
  }
}
