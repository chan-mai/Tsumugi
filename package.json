{
  "name": "tsumugi-root",
  "private": true,
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "pnpm build && pnpm dev:migrate && concurrently --kill-others-on-fail -n tsumugi,worker,dashboard -c blue,green,magenta \"pnpm --filter tsumugi dev\" \"pnpm dev:worker\" \"pnpm --filter @tsumugi/dashboard dev\"",
    "dev:migrate": "wrangler d1 migrations apply TSUMUGI_DB --local -c examples/basic/wrangler.jsonc",
    "dev:worker": "wrangler dev -c examples/basic/wrangler.jsonc -c examples/remote-performer/wrangler.jsonc --port ${TSUMUGI_DEV_PORT:-8787}",
    "build": "pnpm --filter @tsumugi/dashboard build && pnpm --filter @tsumugi/spec build && pnpm --filter tsumugi build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm typecheck && vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint --deny-warnings"
  },
  "devDependencies": {
    "@chan-mai/oxc-config": "^1.3.0",
    "@cloudflare/vitest-plugin": "^1.8.1",
    "@types/node": "^26.6.6",
    "concurrently": "^10.0.7",
    "fast-check": "^4.10.2",
    "oxfmt": "^0.78.0",
    "oxlint": "^1.93.0",
    "oxlint-tsgolint": "^7.0.2007",
    "typescript": "^7.0.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.161.0"
  },
  "packageManager": "pnpm@10.33.4",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "workerd"
    ],
    "packageExtensions": {
      "@nuxtjs/mdc@0.23.2": {
        "dependencies": {
          "hast-util-to-html": "^9.0.5"
        }
      }
    }
  }
}
